# Copy to .env for local use. On Vercel, set these under
# Project → Settings → Environment Variables (Production), then redeploy.
# Never commit real values.

# --- Required for the daily report -----------------------------------------
# Gumroad → Settings → Advanced → Applications → create an app → generate
# an access token. It needs to be able to read your products and sales.
GUMROAD_ACCESS_TOKEN=

# Protects /api/cron/daily. Make up 32+ random characters, e.g.
#   openssl rand -hex 32
# Vercel sends it automatically as "Authorization: Bearer <value>" on each run.
CRON_SECRET=

# Where the reports are saved (your Neon connection string).
DATABASE_URL=

# The password for /admin (and the control panel). Same one for both.
PANEL_PASSWORD=

# --- Optional ---------------------------------------------------------------
# Lets Claude write the promo drafts and the template idea. Without it the
# report still runs, with plain template drafts.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Time zone that decides which "day" a report belongs to. Default Asia/Manila.
# (The schedule itself is in vercel.json and is in UTC.)
# REPORT_TZ=Asia/Manila

# Rotating this signs everyone out of /admin and the panel. Defaults to PANEL_PASSWORD.
# PANEL_SECRET=
